# Copie para .env. O .env nunca entra no git.

# Chave da API do Google Gemini — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=cole-sua-chave-aqui

# Modelo usado no enriquecimento.
GEMINI_MODEL=models/gemini-2.0-flash-001

# Quantas chamadas simultâneas à API. Acima de ~10 o free tier começa a
# devolver 429 e o retry passa a dominar o tempo de execução.
ETL_CONCURRENCY=8
